# Copy to .env.local.
#
# Each workspace adds its own AI API keys in the app (AI accounts). The provider keys and
# Slack/GitHub/Linear tokens below are the OPERATOR's, and are only used for accounts that
# SHARED_AI_KEYS allows: "all" (single-user/self-hosted), a comma-separated list of emails,
# or unset/"off" (everyone brings their own; recommended once others can sign up).
SHARED_AI_KEYS=

# --- Database ---
# Any Postgres (Neon, Supabase, RDS, local). Leave empty to use the embedded
# database in .data/pglite (fine for local development, not for production).
# Required on Vercel. Supabase: Connect → Transaction pooler (port 6543), e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# (a trailing ?pgbouncer=true from Supabase's Prisma snippet is fine). URL-encode special
# characters in the password. TLS is on; set DATABASE_CA_CERT (PEM, \n-escaped ok) to verify
# the server certificate. No ORM or migrations: tables are created on first connect.
DATABASE_URL=
# Optional: session pooler (port 5432), used by `npm run cron:supabase` if set.
# DIRECT_URL=
# DATABASE_CA_CERT=

# Required: encrypts OAuth tokens at rest. At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Chat subscriptions (ChatGPT Plus, Claude Pro, ...) can't be called by third-party apps,
# so live execution uses each vendor's API key.

# --- AI providers ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
XAI_API_KEY=
# XAI_MODEL=grok-4
PERPLEXITY_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# --- Google: "Sign in with Google" + Gmail/Calendar ---
# Google Cloud: create an OAuth client (type: Web application), enable the Gmail API
# and the Google Calendar API, and add this redirect URI:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override when behind a proxy or on a custom domain.
# GOOGLE_REDIRECT_URI=https://your.domain/api/auth/google/callback

# --- Slack: per-workspace "Add to Slack" ---
# Create a Slack app; redirect URL https://<APP_URL>/api/auth/slack/callback (HTTPS only);
# bot scopes channels:read channels:history channels:join groups:read groups:history chat:write users:read.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Operator's server-wide tool tokens (only for SHARED_AI_KEYS accounts) ---
SLACK_BOT_TOKEN=
# Fine-grained token with pull request read + issues write on GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
LINEAR_API_KEY=
# LINEAR_TEAM_ID=

# --- Scheduler (routines) ---
# Long-running servers (`next start`, Docker, VM) run routines in-process every minute.
# Serverless hosts: let Supabase pg_cron call GET /api/cron/tick every minute:
#   DATABASE_URL=… APP_URL=… CRON_SECRET=… npm run cron:supabase
# The endpoint refuses to run without CRON_SECRET (use `openssl rand -hex 32`).
CRON_SECRET=
# SCHEDULER=off   # disable the in-process loop when Supabase cron drives it
# Public URL of the app, used in email links and by the cron installer.
APP_URL=http://localhost:3000

# --- Email alerts (Resend) ---
# Verify your sending domain in Resend first. Without these, alerts aren't sent.
RESEND_API_KEY=
EMAIL_FROM="agentic.do <alerts@yourdomain.com>"
# EMAIL_DRIVER=log  # development: print emails to the console instead of sending

# --- Agent analytics & verification ---
# Registry reviewers (comma-separated emails) who approve agents to T3 Registered.
AA_ADMIN_EMAILS=
# Other Web Bot Auth directories to trust for T2 Signed, e.g. https://chatgpt.com (comma-separated origins).
# Only these are ever fetched; unknown Signature-Agent URLs are not.
AA_TRUSTED_DIRECTORIES=
