# Copy to .env.local.

# --- Database ---
# Any Postgres. Leave empty locally to use the embedded database in .data/pglite.
# Required on Vercel: connect the Supabase integration (it injects <prefix>_POSTGRES_URL,
# which is picked up automatically), or set DATABASE_URL to the transaction pooler, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# URL-encode special characters in the password. Tables are created on first connect.
DATABASE_URL=
# DATABASE_CA_CERT=   # optional PEM (\n-escaped ok) to verify the server certificate

# Required: at least 32 random characters, e.g. `openssl rand -base64 48`.
# Keys the daily IP hash and signed verification tokens.
SESSION_SECRET=

# Public URL, used in email links.
APP_URL=http://localhost:3000

# --- Email (verification + password reset) ---
RESEND_API_KEY=
EMAIL_FROM="agentic.do <hello@yourdomain.com>"
# EMAIL_DRIVER=log  # development: print emails to the console instead of sending

# --- "Continue with Google" (optional) ---
# Google Cloud → OAuth client (Web application), redirect URI:
#   https://<APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your.domain/api/auth/google/callback

# --- Admin ---
# Super admins (comma-separated emails): see every account and its sites and apps at /app/admin.
# They're also registry reviewers. Access needs a CONFIRMED email, so set up email (or Google sign-in) first.
SUPER_ADMIN_EMAILS=

# --- Agent analytics & verification ---
# Registry reviewers (comma-separated, confirmed emails) who approve agents to T3 Registered.
AA_ADMIN_EMAILS=
# Other Web Bot Auth directories to trust for T2 Signed, e.g. https://chatgpt.com (comma-separated origins).
# Only these are ever fetched; unknown Signature-Agent URLs are not.
AA_TRUSTED_DIRECTORIES=
