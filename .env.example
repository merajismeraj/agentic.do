# Copy to .env.local. Any provider with a key runs live; the rest stay in demo mode.
# Chat subscriptions (ChatGPT Plus, Claude Pro, ...) can't be called by third-party apps,
# so live execution uses each vendor's API key.

# --- AI providers ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
XAI_API_KEY=
# XAI_MODEL=grok-4
PERPLEXITY_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# --- Google (Gmail + Calendar), per-user sign-in ---
# Google Cloud: create an OAuth client (type: Web application), enable the Gmail API
# and the Google Calendar API, and add this redirect URI:
#   http://localhost:3000/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override when behind a proxy or on a custom domain.
# GOOGLE_REDIRECT_URI=https://your.domain/api/oauth/google/callback
# Encrypts the Google session cookie. At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# --- Integrations with live connectors (others use demo data for now) ---
# Slack bot token with channels:read, channels:history, chat:write; invite the bot to channels.
SLACK_BOT_TOKEN=
# Fine-grained token with pull request read + issues write on GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
LINEAR_API_KEY=
# LINEAR_TEAM_ID=
